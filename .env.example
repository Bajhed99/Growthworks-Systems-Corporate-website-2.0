# GWS Website - Environment Variables

# Password for accessing the internal preview
# Set this in Vercel dashboard under Project Settings > Environment Variables
# The password will be required to access the deployed site
VITE_GWS_ACCESS_PASSWORD=your_secure_password_here

# 21st.dev MCP Server API Key
# Get your key from: https://21st.dev/account/api-keys
# Set this in Vercel dashboard or .env.local for local development
VITE_21ST_API_KEY=your_21st_api_key_here
